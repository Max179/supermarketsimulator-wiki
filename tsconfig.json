{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "./node_modules/@types"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "pipeline/**/*.mjs",
    "tests/**/*.mjs"
  ]
}
